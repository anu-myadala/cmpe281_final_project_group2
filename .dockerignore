# Build context of the api and stubs images is the repository root: keep it small.
.git
.env
.env.*
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.db
**/*.db-journal
# The web image has its own build context (c1/web); the api and stubs images do not need it.
c1/web
# Local artifact directories of the developer mode and the e2e runs
**/objects
**/e2e-objects
c1/api/tests
docs
deploy
*.md
