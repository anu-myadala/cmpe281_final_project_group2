# SCICP configuration for docker compose (copy to .env). Every service reads this file
# (env_file: .env) and docker compose also uses it for ${...} substitution. Names follow
# docs/BRIEF.md. The values below are development defaults only: change every secret
# before exposing the platform on a public address (deploy/ec2-bootstrap.sh does this).

# --- Databases (hostnames are the compose service names) ---------------------------------
DATABASE_URL=mysql+pymysql://scicp:scicp@mysql:3306/scicp
MYSQL_ROOT_PASSWORD=root-change-me
MONGO_URL=mongodb://mongo:27017/scicp

# --- Security -------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
SERVICE_TOKEN_SECRET=change-me-to-another-long-random-string-0123456789
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Object storage for the model artifacts ---------------------------------------------------
# local: files on the named volume "objects" of docker-compose.yml, served by the API through
#        signed /api/v1/storage/objects/... URLs (works behind nginx on any host name).
# s3:    Amazon S3 (docker-compose.aws.yml sets it on EC2, with the instance role or the
#        AWS_S3_* keys at the end of this file).
STORAGE_BACKEND=local
STORAGE_DIR=/data/objects
S3_REGION=us-west-2
S3_MODELS_BUCKET=scicp-models
S3_CLIPS_BUCKET=scicp-clips

# --- Mail: smtp (MailHog at http://localhost:8025), ses, or log ------------------------------
MAIL_MODE=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=no-reply@scicp.example

# --- MQTT (model.activated for the C4 worker; optional) -----------------------------------
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=svc-api
MQTT_PASSWORD=change-me

# --- Neighboring components (the stubs container; the real C2/C3 replace these URLs) ------
C2_BASE_URL=http://stubs:8002/api/v1
C3_BASE_URL=http://stubs:8003/api/v1
# Where the stubs reach C1 (POST /internal/events, feedback labels)
C1_BASE_URL=http://api:8000/api/v1

# --- Web --------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WEB_PORT=8080
# Public hostname of the EC2 instance (docker-compose.aws.yml builds CORS_ORIGINS from it)
PUBLIC_HOST=localhost

# --- Developer / CI mode (single process, see README "Developer mode") ---------------------
STUBS_INLINE=0
SEED_ON_START=0
OVERVIEW_LOCAL_FALLBACK=0
LOG_LEVEL=INFO

# --- Demo event generator (stubs/generator.py) ------------------------------------------------
DEMO_ENABLED=1
DEMO_TICK_S=10
DEMO_ALERT_PERIOD_S=150
DEMO_MAX_ALERTS=30
DEMO_DEVICE_FAULT_MEAN_S=60
DEMO_ONLINE_VEHICLES=AV-01,AV-10,AV-11,AV-12

# --- AWS only (docker-compose.aws.yml); leave empty when the EC2 instance role grants S3 ------
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_MAIL_MODE=log
