# SCICP C1 API configuration (copy to .env). Names follow docs/BRIEF.md.

# Databases (sync driver URLs from the brief are accepted and mapped to the async drivers)
DATABASE_URL=mysql+pymysql://scicp:scicp@mysql:3306/scicp
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
MONGO_URL=mongodb://mongo:27017/scicp
# MONGO_URL=mock                      # in-process mongomock (tests, developer mode)

# Security (use long random values in production)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
SERVICE_TOKEN_SECRET=change-me-to-another-long-random-string
COOKIE_SECURE=false                   # true behind HTTPS
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Model artifacts: local (a directory served through signed /api/v1/storage/objects/... URLs)
# or s3 (Amazon S3 with the instance role, or S3_ACCESS_KEY / S3_SECRET_KEY)
STORAGE_BACKEND=local
STORAGE_DIR=/data/objects             # ./objects in the developer mode
S3_REGION=us-west-2
S3_MODELS_BUCKET=scicp-models
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Mail: smtp (MailHog), ses, or log
MAIL_MODE=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=no-reply@scicp.example

# MQTT (optional; unset = log and skip the model.activated publish)
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=svc-api
MQTT_PASSWORD=change-me

# Neighboring components (the stubs in docker compose, or the API itself with STUBS_INLINE=1)
C2_BASE_URL=http://stubs:8002/api/v1
C3_BASE_URL=http://stubs:8003/api/v1
# C2_BASE_URL=http://localhost:8000/c2/api/v1
# C3_BASE_URL=http://localhost:8000/c3/api/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Developer / CI mode
STUBS_INLINE=0                        # 1 mounts stubs.app under /c2/api/v1 and /c3/api/v1
SEED_ON_START=0                       # 1 runs seed/seed.py in process at startup
OVERVIEW_LOCAL_FALLBACK=0             # 1 builds the overview from the local tables when C2/C3 are down (instead of 502)
LOG_LEVEL=INFO
