# Base paths of the C2 and C3 APIs as the browser reaches them (same origin, proxied by Vite / nginx).
VITE_C2_BASE=/c2/api/v1
VITE_C3_BASE=/c3/api/v1
# Where the dev server proxies /api, /ws (and /c2, /c3 when the stubs run inline) to.
VITE_PROXY_API=http://localhost:8000
# VITE_PROXY_STUBS=http://localhost:8002
